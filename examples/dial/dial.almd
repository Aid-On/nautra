// Opens one TCP connection: needs the destination granted with --allow-net.
import env
import io
import net

effect fn main() -> Unit = {
  let args = env.args()
  let host = list.get(args, 0) ?? "example.com"
  let port = int.parse(list.get(args, 1) ?? "80") ?? 80
  let stream = net.tcp_connect(host, port)!
  io.close(stream)!
  println("connected to ${host}:${port}")
}
