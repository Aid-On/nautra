// Prints the variables it was given, one per line, sorted.
import env

effect fn main() -> Unit = {
  let vars = env.vars()! |> map.to_list |> list.sort_by(((name, _)) => name)
  if list.is_empty(vars) then println("(no environment)") else {
    for (name, v) in vars {
      println("${name}=${v}")
    }
  }
}
