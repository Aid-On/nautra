// SPDX-License-Identifier: Apache-2.0
// Every call into the native engine (native/engine.rs). Policy is decided on
// this side; the engine receives one finished request and applies it.

import http
import json
import secret
import self.authenticator
import self.grants

@extern(rs, "engine", "nt_run")
fn nt_run(request_json: String) -> String

@extern(rs, "engine", "nt_serve")
fn nt_serve(request_json: String) -> String

@extern(rs, "engine", "nt_spawn_self")
fn nt_spawn_self(request_json: String) -> String

@extern(rs, "engine", "nt_inspect")
fn nt_inspect(path: String) -> String

@extern(rs, "engine", "nt_toml_to_json")
fn nt_toml_to_json(text: String) -> String

@extern(rs, "engine", "nt_http_upload")
fn nt_http_upload(request_json: String) -> String

// What a .wasm file is and which names it imports and exports.
type Surface = { kind: String, imports: List[String], exports: List[String], size: Int }

// How a run ended. `error` is empty when the guest chose its own exit;
// `replayed` counts the exchanges that were answered from a record.
type Outcome = { exit_code: Int, error: String, replayed: Int }

local fn strings(doc: Value, key: String) -> List[String] =
  (value.get_array(doc, key) ?? []) |> list.filter_map((item) => value.as_string(item)?)

effect fn inspect(path: String) -> Surface = {
  let doc = json.parse(nt_inspect(path))!
  guard let message = value.get_string(doc, "error") else none => Surface {
    kind: value.get_string(doc, "kind") ?? "module",
    imports: strings(doc, "imports"),
    exports: strings(doc, "exports"),
    size: value.get_int(doc, "size") ?? 0,
  }
  err(message)!
}

effect fn toml(text: String) -> Value = {
  let doc = json.parse(nt_toml_to_json(text))!
  match value.get(doc, "ok") {
    some(parsed) => parsed,
    none => err(value.get_string(doc, "error") ?? "not TOML")!,
  }
}

local fn mount_value(m: grants.Mount) -> Value =
  value.object([("host", value.string(m.host)), ("guest", value.string(m.guest)), ("readonly", value.bool(m.readonly))])

local fn net_value(g: grants.Grants) -> Value =
  if g.net_all then value.object([("mode", value.string("all"))])
  else if list.is_empty(g.net) then value.object([("mode", value.string("none"))])
  else value.object([
    ("mode", value.string("list")),
    ("allow", value.array(g.net |> list.map((rule) => value.object([("host", value.string(rule.host)), ("port", value.int(rule.port))])))),
  ])

// A secret as the engine needs it: the placeholder the guest holds, the real
// value, and where the real value may go.
type BoundSecret = { name: String, placeholder: String, value: Secret[String], hosts: List[grants.NetRule] }

local fn secret_value(s: BoundSecret) -> Value = value.object([
  ("name", value.string(s.name)),
  ("placeholder", value.string(s.placeholder)),
  ("value", value.string(secret.reveal(s.value))),
  ("hosts", value.array(s.hosts |> list.map((rule) => value.object([("host", value.string(rule.host)), ("port", value.int(rule.port))])))),
])

// A destination the engine has authenticated for. No key is here, and no
// meaning: the engine hands `scheme` and `params` back, as they are, to
// nautra's answering copy (authenticator.almd), which knows the scheme and
// finds the credentials itself. `body` says whether to hash each body.
local fn auth_value(a: authenticator.Resolved) -> Value = value.object([
  ("scheme", value.string(a.scheme)),
  ("host", value.string(a.host.host)),
  ("port", value.int(a.host.port)),
  ("params", value.array(a.params |> list.map(((key, written)) => value.array([value.string(key), value.string(written)])))),
  ("body", value.bool(a.body)),
])

// The request document the engine applies. `argv` starts with the name the
// guest sees itself run as; `env` is already resolved to name/value pairs.
// This is the one place a secret's real value is written out, and it goes
// nowhere but to the engine in this process.
fn request(path: String, argv: List[String], env: List[(String, String)], g: grants.Grants, secrets: List[BoundSecret], auths: List[authenticator.Resolved]) -> Value =
  value.object([
    ("secrets", value.array(secrets |> list.map(secret_value))),
    ("auth", value.array(auths |> list.map(auth_value))),
    ("audit", value.string(g.audit)),
    ("path", value.string(path)),
    ("args", value.array(argv |> list.map(value.string))),
    ("env", value.array(env |> list.map(((name, v)) => value.array([value.string(name), value.string(v)])))),
    ("mounts", value.array(g.mounts |> list.map(mount_value))),
    ("net", net_value(g)),
    ("memory_bytes", value.int(g.memory_bytes)),
    ("timeout_ms", value.int(g.timeout_ms)),
    ("fuel", value.int(g.fuel)),
    ("stdin", value.bool(g.stdin)),
    ("listen", value.string(g.publish)),
  ])

// Runs to completion on this process's stdout and stderr. A request that
// names an address to listen on is served there until interrupted.
effect fn run(req: Value) -> Outcome = {
  let serving = (value.get_string(req, "listen") ?? "") != ""
  let doc = json.parse(if serving then nt_serve(json.stringify(req)) else nt_run(json.stringify(req)))!
  Outcome {
    exit_code: value.get_int(doc, "exit_code") ?? 125,
    error: value.get_string(doc, "error") ?? "",
    replayed: value.get_int(doc, "replayed") ?? 0,
  }
}

// One HTTP request with a file as its body, byte for byte. Almide 0.70's http
// client carries request bodies as text, so binary uploads go through here.
effect fn upload(method: String, target: String, headers: List[(String, String)], file: String) -> HttpResponse = {
  let req = value.object([
    ("method", value.string(method)),
    ("url", value.string(target)),
    ("headers", value.array(headers |> list.map(((name, v)) => value.array([value.string(name), value.string(v)])))),
    ("path", value.string(file)),
  ])
  let doc = json.parse(nt_http_upload(json.stringify(req)))!
  guard let status = value.get_int(doc, "status") else none => err(value.get_string(doc, "error") ?? "upload failed")!
  let pairs = (value.get_array(doc, "headers") ?? []) |> list.filter_map((pair) => match value.as_array(pair) {
    ok([name, v]) => some((value.as_string(name) ?? "", value.as_string(v) ?? "")),
    _ => none,
  })
  http.with_headers(status, value.get_string(doc, "body") ?? "", pairs)
}

// Starts nautra itself again in the background with these arguments, its
// output appended to `log`. Returns the new process id.
effect fn spawn_self(args: List[String], log: String) -> Int = {
  let req = value.object([("args", value.array(args |> list.map(value.string))), ("log", value.string(log))])
  let doc = json.parse(nt_spawn_self(json.stringify(req)))!
  guard let pid = value.get_int(doc, "pid") else none => err(value.get_string(doc, "error") ?? "cannot start in the background")!
  pid
}

test "a request with no grants opens nothing" {
  let req = request("/x/app.wasm", ["app"], [], grants.nothing(), [], [])
  assert_eq(value.get_array(req, "mounts"), some([]))
  assert_eq(value.get_array(req, "env"), some([]))
  assert_eq(value.get(req, "net"), some(value.object([("mode", value.string("none"))])))
  assert_eq(value.get_bool(req, "stdin"), some(false))
}

test "network grants become a list, and * becomes all" {
  let listed = { ...grants.nothing(), net: [grants.NetRule { host: "example.com", port: 443 }] }
  assert_eq(value.get_string(net_value(listed), "mode"), some("list"))
  let everything = { ...grants.nothing(), net_all: true, net: [grants.NetRule { host: "example.com", port: 443 }] }
  assert_eq(value.get_string(net_value(everything), "mode"), some("all"))
}
