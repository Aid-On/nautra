// The nautra command line: dispatch, and one function per command.

import env
import fs
import hex
import io
import json
import path
import process
import random
import secret
import self.compose
import self.engine
import self.grants
import self.help
import self.image
import self.native
import self.oci
import self.reference
import self.registry
import self.runs
import self.store

// A workload ready to run: the binary on disk, the name it sees itself run
// as, and what its image says about running it.
type Target = { path: String, name: String, config: image.Config }

fn human_size(n: Int) -> String = {
  let tenths = (unit: Int) => {
    let scaled = n * 10 / unit
    "${scaled / 10}.${scaled % 10}"
  }
  if n < 1000 then "${n} B"
  else if n < 1000000 then "${tenths(1000)} kB"
  else if n < 1000000000 then "${tenths(1000000)} MB"
  else "${tenths(1000000000)} GB"
}

fn short(digest: String) -> String = string.take(string.strip_prefix(digest, "sha256:") ?? digest, 12)

// Rows as aligned columns, two spaces apart.
fn table(rows: List[List[String]]) -> String = {
  let columns = rows |> list.map((row) => list.len(row)) |> list.max ?? 0
  let widths = list.range(0, columns) |> list.map((c) => rows |> list.map((row) => string.len(list.get(row, c) ?? "")) |> list.max ?? 0)
  rows
    |> list.map((row) => list.zip_with(row, widths, (cell, width) => string.pad_end(cell, width, " ")) |> list.join("  ") |> string.trim_end)
    |> list.join("\n")
}

local fn kind_of(config: Value) -> String = match value.get_string(config, "os") ?? "" {
  "wasip1" => "module",
  "wasip2" => "component",
  _ => "wasm",
}

// The standard config blob of an image, or an empty object when it has none
// that parses.
local effect fn config_doc(store_dir: String, m: oci.Manifest) -> Value =
  (store.read_blob(store_dir, m.config.digest)? |> option.flat_map((data) => json.parse(bytes.to_string_lossy(data))?)) ?? value.object([])

local effect fn pull_into(store_dir: String, r: reference.Reference) -> oci.Descriptor = {
  eprintln("pulling ${reference.key(r)}")
  registry.pull(store_dir, r)!
}

// Finds what `run` was pointed at: a .wasm file as it is, or an image from
// the store, pulled first when it names a registry and is not stored yet.
local effect fn locate(text: String) -> Target = {
  if fs.is_file(text) then Target { path: text, name: path.basename(text), config: image.empty() } else {
    let r = reference.parse(text) |> result.map_err((e) => "no file named '${text}', and ${e}")!
    let store_dir = store.open()!
    let stored = match store.resolve(store_dir, reference.key(r))! {
      some(d) => d,
      none => {
        guard r.registry != "" else err("no image named ${reference.key(r)}: build it with `nautra build -t ${reference.key(r)}`, or name a registry to pull from")!
        pull_into(store_dir, r)!
      },
    }
    let manifest = store.read_manifest(store_dir, stored.digest)!
    let layer = oci.wasm_layer(manifest) |> option.to_result("${reference.key(r)} has no WebAssembly layer to run")!
    // Reading the blob checks it against its digest before it is run.
    let _ = store.read_blob(store_dir, layer.digest)!
    Target {
      path: store.blob_path(store_dir, layer.digest),
      name: path.basename(r.repository),
      config: image.config_of(manifest),
    }
  }
}

// The guest's environment: the image's own variables, then the run's, a
// later one replacing an earlier one of the same name. A bare `-e NAME` the
// host does not have is left out.
local effect fn environment(config: image.Config, wanted: List[grants.EnvGrant]) -> List[(String, String)] = {
  var pairs: List[(String, String)] = config.env |> list.map((e) => (e.name, e.value))
  for grant in wanted {
    match option.or_else(grant.value, () => env.get(grant.name)) {
      some(v) => { pairs = (pairs |> list.filter(((name, _)) => name != grant.name)) + [(grant.name, v)] },
      none => (),
    }
  }
  pairs
}

// Reads each secret from the host's environment and gives it a placeholder:
// a value that means nothing, for the guest to hold in the secret's place.
local effect fn bind_secrets(wanted: List[grants.SecretGrant], live: Bool) -> List[engine.BoundSecret] = {
  var bound: List[engine.BoundSecret] = []
  for grant in wanted {
    let held = if live then env.secret(grant.name)! |> option.to_result("secret ${grant.name} is not set in the environment")! else secret.new("")
    bound = bound + [engine.BoundSecret {
      name: grant.name,
      placeholder: "nautra-secret-${hex.encode(random.bytes(16))}",
      value: held,
      hosts: grant.hosts,
    }]
  }
  bound
}

// Everything a run needs, decided: the request document the engine applies.
// The workload is found (and pulled if need be), its grants are checked, and
// its secrets are bound.
//
// `mode` says how the run relates to a record: "record" starts one,
// "replay" and "resume" follow one, "" has none. `written` is the run line
// a new record is headed with.
local effect fn prepare(line: grants.RunLine, mode: String, written: List[String]) -> Value = {
  for mount in line.grants.mounts {
    guard fs.is_dir(mount.host) else err("cannot mount '${mount.host}': it is not a directory")!
  }
  let target = locate(line.image)!
  let argv = [target.name] + (if list.is_empty(line.args) then target.config.args else line.args)
  let missing = image.ungranted(target.config, line.grants)
  if not list.is_empty(missing) then {
    eprintln("nautra: this image asks for grants this run does not give: ${list.join(missing, "  ")}")
  }
  // An HTTP service exports a handler instead of a `run`; it has to be told
  // where to listen.
  let service = engine.inspect(target.path)!.exports |> list.any((name) => string.starts_with(name, "wasi:http/handler") or string.starts_with(name, "wasi:http/incoming-handler"))
  guard not service or line.grants.publish != "" else err("this is an HTTP service: publish it with -p PORT, for example `nautra run -p 8080 ${line.image}`")!
  // A replay sends nothing anywhere, so it needs no secret's value.
  let secrets = bind_secrets(line.grants.secrets, mode != "replay")!
  // The guest holds each secret's placeholder under the secret's name.
  let env_pairs = (environment(target.config, line.grants.env)! |> list.filter(((name, _)) => not list.any(secrets, (s) => s.name == name)))
    + (secrets |> list.map((s) => (s.name, s.placeholder)))
  let request = engine.request(target.path, argv, env_pairs, line.grants, secrets)
  if mode == "" then request else {
    // A record is tied to the exact binary it was made with.
    let header = value.object([
      ("wasm", value.string(store.digest_of(fs.read_bytes(target.path)!))),
      ("run", value.array(written |> list.map(value.string))),
      ("cwd", value.string(env.cwd()!)),
    ])
    value.merge(request, value.object([("journal", value.object([
      ("path", value.string(line.grants.record)),
      ("mode", value.string(mode)),
      ("header", header),
    ]))]))
  }
}

// How deep agents may hand work to agents. A file that names itself, or two
// that name each other, runs into this.
let MAX_DEPTH = 4

// An entry's own options as a run line, its decisions recorded in `audit`
// with those of the workload it belongs to.
local fn entry_line(options: List[String], image_text: String, audit: String, what: String) -> grants.RunLine! = {
  let parsed = grants.parse_run(options + [image_text]) |> result.map_err((e) => "${what}: ${e}")!
  { ...parsed, grants: { ...parsed.grants, audit: audit } }
}

// The request of a native command: Porta, and the arguments that were
// worked out for it from the entry's grants.
local effect fn native_request(args: List[String]) -> Value =
  value.object([("native", value.object([
    ("program", value.string(native.porta()!)),
    ("args", value.array(args |> list.map(value.string))),
  ]))])

// One tool as the engine needs it: its name and schema for the workload to
// see, and the whole request it runs under each time it is called — decided
// now, before anything starts. A tool that is an agent brings its own tools.
// When `live` is false the run is a replay, which is given each tool's
// recorded result, so nothing is prepared.
local effect fn tool_entry(t: compose.Tool, audit: String, live: Bool, depth: Int) -> Value = {
  let what = "tool ${t.name}"
  let request = if not live then value.null() else if not list.is_empty(t.native) then {
    native_request(t.native) |> result.map_err((e) => "${what}: ${e}")!
  } else if t.agent == "" then {
    prepare(entry_line(t.options, t.image, audit, what)!, "", []) |> result.map_err((e) => "${what}: ${e}")!
  } else {
    guard depth < MAX_DEPTH else err("${what}: agents hand work on more than ${MAX_DEPTH} deep; ${t.agent} may be naming itself")!
    let (expanded, inner) = compose.expand(["-f", t.agent]) |> result.map_err((e) => "${what}: ${e}")!
    let parsed = grants.parse_run(expanded) |> result.map_err((e) => "${what}: ${e}")!
    let line = { ...parsed, grants: { ...parsed.grants, audit: audit } }
    whole_request(line, inner, "", [], depth + 1) |> result.map_err((e) => "${what}: ${e}")!
  }
  value.object([
    ("name", value.string(t.name)),
    ("description", value.string(t.description)),
    ("input", t.input),
    ("max_calls", value.int(t.max_calls)),
    ("task", value.bool(t.agent != "")),
    ("request", request),
  ])
}

local effect fn check_entry(c: compose.Check, audit: String, live: Bool) -> Value = {
  let what = "check ${c.name}"
  let request = if not live then value.null()
    else if not list.is_empty(c.native) then native_request(c.native) |> result.map_err((e) => "${what}: ${e}")!
    else prepare(entry_line(c.options, c.image, audit, what)!, "", []) |> result.map_err((e) => "${what}: ${e}")!
  value.object([
    ("name", value.string(c.name)),
    ("before", value.array(c.before |> list.map(value.string))),
    ("finish", value.bool(c.finish)),
    ("request", request),
  ])
}

// The request of a workload together with everything its composition gives
// it: its tools and its checks, each with a request of its own.
local effect fn whole_request(line: grants.RunLine, composed: compose.Composition?, mode: String, written: List[String], depth: Int) -> Value = {
  let base = prepare(line, mode, written)!
  match composed {
    none => base,
    some(c) => {
      let live = mode != "replay"
      var tools: List[Value] = []
      for t in c.tools {
        tools = tools + [tool_entry(t, line.grants.audit, live, depth)!]
      }
      var checks: List[Value] = []
      for k in c.checks {
        checks = checks + [check_entry(k, line.grants.audit, live)!]
      }
      value.merge(base, value.object([
        ("tools", value.array(tools)),
        ("checks", value.array(checks)),
        ("max_tool_calls", value.int(c.max_tool_calls)),
      ]))
    },
  }
}

// One run on this process, to its end: what `run` does, and what the
// process behind a background run does.
local effect fn run_here(line: grants.RunLine, composed: compose.Composition?, mode: String, written: List[String]) -> Int = {
  let outcome = engine.run(whole_request(line, composed, mode, written, 0)!)!
  if outcome.error != "" then {
    eprintln("nautra: ${outcome.error}")
  } else if mode == "replay" then {
    eprintln("nautra: the run matches its record: ${outcome.replayed} exchange(s) replayed, nothing sent")
  } else if mode == "resume" then {
    eprintln("nautra: resumed after ${outcome.replayed} recorded exchange(s)")
  }
  outcome.exit_code
}

// A run line as a record keeps it: without the options that are about this
// one invocation rather than about the run.
fn written_line(args: List[String]) -> List[String] = {
  let n = grants.option_count(args)
  var kept: List[String] = []
  var skip = false
  for option in list.take(args, n) {
    if skip then {
      skip = false
    } else if list.contains(["--record", "--name", "--run-id"], option) then {
      skip = true
    } else if not list.contains(["-d", "--detach", "--rm"], option) and not list.any(["--record=", "--name=", "--run-id="], (p) => string.starts_with(option, p)) then {
      kept = kept + [option]
    }
  }
  kept + list.drop(args, n)
}

// The first line of a record, when the file is one.
local effect fn record_header(file: String) -> Value? = {
  let first = fs.read_text(file)? |> option.flat_map((text) => list.first(string.lines(text)))
  first |> option.flat_map((line) => json.parse(line)?) |> option.filter((doc) => value.get_int(doc, "record") == some(1))
}

// Runs again the line a record was made with, following the record:
// "replay" answers every exchange from it, "resume" continues after it.
local effect fn follow_record(file: String, mode: String) -> Int = {
  let header = record_header(file)! |> option.to_result("${file} is not a nautra record")!
  let written = (value.get_array(header, "run") ?? []) |> list.filter_map((arg) => value.as_string(arg)?)
  let made_in = value.get_string(header, "cwd") ?? ""
  guard made_in == "" or made_in == env.cwd()! else err("this run was recorded in ${made_in}; run this from there, so its paths mean the same")!
  let (expanded, composed) = compose.expand(written)!
  let parsed = grants.parse_run(expanded)!
  let line = { ...parsed, grants: { ...parsed.grants, record: file } }
  run_here(line, composed, mode, written)!
}

// Starts a run in the background and prints its id. Everything that can be
// refused is refused here, in front of the person asking; the background
// process then does the same run again with no terminal.
local effect fn start_detached(args: List[String], line: grants.RunLine) -> Int = {
  for mount in line.grants.mounts {
    guard fs.is_dir(mount.host) else err("cannot mount '${mount.host}': it is not a directory")!
  }
  let target = locate(line.image)!
  let id = runs.new_id()!
  let derived = "${string.strip_suffix(target.name, ".wasm") ?? target.name}-${string.take(id, 6)}"
  let name = if line.name != "" then line.name else if grants.is_run_name(derived) then derived else id
  guard not runs.is_name_taken(name)! else err("a run named '${name}' already exists: remove it with `nautra rm ${name}`, or pick another --name")!
  fs.mkdir_p(runs.dir(id)!)!
  // The background process is given the line as it was written — a
  // composition file and all — less the options that ask for the background.
  let options = grants.option_count(args)
  let pid = engine.spawn_self(["run", "--run-id", id] + runs.child_options(list.take(args, options)) + list.drop(args, options), runs.log_path(id)!)!
  runs.save(runs.Run {
    id: id,
    name: name,
    image: line.image,
    pid: pid,
    born: runs.born(pid)! ?? "",
    started: datetime.to_iso(datetime.now()),
    publish: line.grants.publish,
    args: line.args,
  })!
  // A run that fails at once (a port already taken, say) is reported now
  // rather than left to be found in `ps`.
  env.sleep_ms(300)
  match runs.exit_code(id)! {
    some(code) if code != 0 => {
      eprintln(string.trim_end(fs.read_text(runs.log_path(id)!) ?? ""))
      eprintln("nautra: ${name} ended at once with exit code ${code}")
      code
    },
    _ => {
      println(id)
      0
    },
  }
}

local effect fn cmd_run(args: List[String]) -> Int = match args {
  ["--resume", file] => follow_record(file, "resume")!,
  _ => start_run(args)!,
}

local effect fn start_run(args: List[String]) -> Int = {
  let (expanded, composed) = compose.expand(args)!
  let line = grants.parse_run(expanded)!
  let mode = if line.grants.record == "" then "" else "record"
  let written = written_line(args)
  if line.detach then start_detached(args, line)!
  else if line.run_id == "" then run_here(line, composed, mode, written)!
  else {
    // This process is a background run: it reports to its record.
    runs.await_record(line.run_id)!
    let code = match run_here(line, composed, mode, written) {
      ok(c) => c,
      err(message) => {
        eprintln("nautra: ${message}")
        125
      },
    }
    if line.remove then fs.remove_all(runs.dir(line.run_id)!)! else runs.record_exit(line.run_id, code)!
    code
  }
}

local effect fn cmd_ps(args: List[String]) -> Int = {
  let everything = list.contains(args, "-a") or list.contains(args, "--all")
  guard list.all(args, (a) => a == "-a" or a == "--all") else err("ps takes only -a")!
  var rows = [["ID", "NAME", "IMAGE", "STATUS", "PORT", "STARTED"]]
  for r in runs.all()! {
    let state = runs.status(r)!
    if everything or state == "running" then {
      rows = rows + [[r.id, r.name, image.printable(r.image), state, if r.publish == "" then "-" else r.publish, r.started]]
    }
  }
  println(table(rows))
  0
}

// Prints what a run has written so far; with -f, keeps printing until it ends.
local effect fn cmd_logs(args: List[String]) -> Int = {
  let follow = list.contains(args, "-f") or list.contains(args, "--follow")
  let names = args |> list.filter((a) => not string.starts_with(a, "-"))
  guard list.len(names) == 1 and list.len(args) <= 2 else err("logs takes one run: nautra logs [-f] NAME")!
  let r = runs.find(list.get(names, 0) ?? "")!
  let file = runs.log_path(r.id)!
  var seen = 0
  var running = true
  while running {
    // Whether it is running is read before the log, so that the last lines
    // written just before it ended are not missed.
    running = follow and runs.alive(r)!
    let data = fs.read_bytes(file) ?? bytes.new()
    if bytes.len(data) > seen then {
      io.write(io.stdout()!, bytes.drop(data, seen))!
      seen = bytes.len(data)
    }
    if running then {
      env.sleep_ms(200)
    }
  }
  0
}

local effect fn cmd_stop(args: List[String]) -> Int = {
  let (grace_ms, names) = match args {
    ["-t", seconds, ..rest] => (grants.parse_duration(seconds)!, rest),
    _ => (10000, args),
  }
  guard not list.is_empty(names) else err("stop needs at least one run")!
  var idle = 0
  for text in names {
    let r = runs.find(text)!
    if runs.stop(r, grace_ms)! then println(r.name) else {
      eprintln("nautra: ${r.name} is not running")
      idle = idle + 1
    }
  }
  if idle == 0 then 0 else 1
}

// Forgets runs that have ended; -f stops one that has not.
local effect fn cmd_rm(args: List[String]) -> Int = {
  let force = list.contains(args, "-f") or list.contains(args, "--force")
  let names = args |> list.filter((a) => a != "-f" and a != "--force")
  guard not list.is_empty(names) else err("rm needs at least one run")!
  for text in names {
    let r = runs.find(text)!
    if runs.alive(r)! then {
      guard force else err("${r.name} is running: stop it first, or use `nautra rm -f ${r.name}`")!
      let _ = runs.stop(r, 10000)!
    }
    runs.remove(r)!
    println(r.name)
  }
  0
}

type BuildLine = { tags: List[String], file: String, context: String }

local fn parse_build(args: List[String]) -> BuildLine! = {
  var line = BuildLine { tags: [], file: "", context: "" }
  var i = 0
  while i < list.len(args) {
    let arg = list.get(args, i) ?? ""
    i = i + 1
    if arg == "-t" or arg == "--tag" or arg == "-f" or arg == "--file" then {
      let text = list.get(args, i) |> option.to_result("${arg} needs a value")!
      i = i + 1
      line = if string.starts_with(arg, "-t") or arg == "--tag" then { ...line, tags: line.tags + [text] } else { ...line, file: text }
    } else if string.starts_with(arg, "-") then {
      err("unknown option '${arg}'")!
    } else {
      guard line.context == "" else err("build takes one path, got '${line.context}' and '${arg}'")
      line = { ...line, context: arg }
    }
  }
  line
}

// The moment recorded in an image. SOURCE_DATE_EPOCH pins it, so the same
// inputs give the same digest.
local effect fn created_now() -> String = match env.get("SOURCE_DATE_EPOCH") {
  some(text) => datetime.to_iso(int.parse(text) |> result.map_err((_) => "SOURCE_DATE_EPOCH is not a number of seconds")!),
  none => datetime.to_iso(datetime.now()),
}

local effect fn cmd_build(args: List[String]) -> Int = {
  let line = parse_build(args)!
  let context = if line.context == "" then "." else line.context
  let names = line.tags |> list.map((t) => reference.parse(t)!)!
  let (wasm_path, r) = if line.file == "" and fs.is_file(context) then {
    (context, image.Recipe { wasm: context, description: "", config: image.empty() })
  } else {
    let file = if line.file != "" then line.file else path.join(context, "Nautrafile")
    let text = fs.read_text(file) |> result.map_err((e) => "cannot read ${file}: ${e}")!
    let parsed = image.recipe(engine.toml(text) |> result.map_err((e) => "${file}: ${e}")!) |> result.map_err((e) => "${file}: ${e}")!
    (if path.is_absolute(parsed.wasm) then parsed.wasm else path.join(path.dirname(file), parsed.wasm), parsed)
  }
  let store_dir = store.open()!
  let manifest = image.build(store_dir, wasm_path, r, created_now()!)!
  for n in names {
    store.set_ref(store_dir, reference.key(n), manifest)!
    println("${reference.key(n)}  ${manifest.digest}")
  }
  if list.is_empty(names) then {
    println(manifest.digest)
  }
  0
}

local effect fn cmd_images() -> Int = {
  let store_dir = store.open()!
  var rows = [["NAME", "DIGEST", "KIND", "SIZE", "CREATED"]]
  for (name, d) in store.list_refs(store_dir)! |> list.sort_by(((n, _)) => n) {
    let row = match store.read_manifest(store_dir, d.digest) {
      ok(m) => {
        let size = oci.wasm_layer(m) |> option.map((layer) => human_size(layer.size))
        [name, short(d.digest), kind_of(config_doc(store_dir, m)!), size ?? "-", image.printable(oci.annotation(m.annotations, oci.CREATED) ?? "-")]
      },
      err(_) => [name, short(d.digest), "damaged", "-", "-"],
    }
    rows = rows + [row]
  }
  println(table(rows))
  0
}

local fn listed(label: String, items: List[String]) -> List[String] =
  if list.is_empty(items) then [] else ["${label}${list.join(items |> list.map(image.printable), ", ")}"]

local fn surface_lines(kind: String, size: Int, imports: List[String]) -> List[String] = {
  let reach = image.reach(imports)
  [
    "kind      ${kind}",
    "size      ${human_size(size)}",
    "reach     ${if list.is_empty(reach) then "nothing beyond stdio and exit" else list.join(reach, ", ")}",
  ]
}

// What a record holds, read without running anything: the workload, the
// line it was run with, and how far the run got.
local effect fn record_lines(file: String) -> List[String] = {
  let entries = string.lines(fs.read_text(file)!) |> list.filter_map((line) => json.parse(line)?)
  let header = list.first(entries) ?? value.null()
  let begun = entries |> list.filter_map((e) => value.get(e, "begin"))
  let ended = entries |> list.count((e) => option.is_some(value.get(e, "end")))
  let of_kind = (kind: String) => begun |> list.count((b) => value.get_string(b, "kind") == some(kind))
  let exit = entries |> list.find_map((e) => value.get_int(e, "exit"))
  let state = match exit {
    some(code) => "finished, exit code ${code}",
    none => if ended < list.len(begun) then "stopped with an exchange in flight; it cannot be resumed past that point" else "stopped after ${ended} exchange(s); `nautra run --resume ${file}` continues it",
  }
  let written = (value.get_array(header, "run") ?? []) |> list.filter_map((arg) => value.as_string(arg)?)
  [
    "record    ${file}",
    "wasm      ${value.get_string(header, "wasm") ?? "?"}",
    "run       ${image.printable(list.join(written, " "))}",
    "in        ${image.printable(value.get_string(header, "cwd") ?? "?")}",
    "exchanges ${list.len(begun)} (${of_kind("http")} http, ${of_kind("tool")} tool)",
    "state     ${state}",
  ]
}

local effect fn cmd_replay(args: List[String]) -> Int = match args {
  [file] => follow_record(file, "replay")!,
  _ => err("replay takes one record: nautra replay FILE")!,
}

local effect fn cmd_inspect(args: List[String]) -> Int = {
  let text = list.get(args, 0) |> option.to_result("inspect needs an image, a .wasm file or a record")!
  if option.is_some(record_header(text)!) then {
    println(list.join(record_lines(text)!, "\n"))
  } else if fs.is_file(text) then {
    let surface = engine.inspect(text)!
    println((["file      ${text}"] + surface_lines(surface.kind, surface.size, surface.imports)) |> list.join("\n"))
  } else {
    let r = reference.parse(text) |> result.map_err((e) => "no file named '${text}', and ${e}")!
    let store_dir = store.open()!
    let stored = store.resolve(store_dir, reference.key(r))! |> option.to_result("no image named ${reference.key(r)}")!
    let m = store.read_manifest(store_dir, stored.digest)!
    let layer = oci.wasm_layer(m) |> option.to_result("${reference.key(r)} has no WebAssembly layer")!
    let surface = engine.inspect(store.blob_path(store_dir, layer.digest))!
    let config = image.config_of(m)
    let wants = (config.wants.mounts |> list.map((dir) => "-v <dir>:${dir}"))
      + (config.wants.net |> list.map((destination) => "--allow-net ${destination}"))
      + (config.wants.env |> list.map((name) => "-e ${name}"))
    let lines = ["name      ${reference.key(r)}", "digest    ${stored.digest}", "wasm      ${layer.digest}"]
      + surface_lines(surface.kind, surface.size, surface.imports)
      + listed("created   ", option.to_list(oci.annotation(m.annotations, oci.CREATED)))
      + listed("about     ", option.to_list(oci.annotation(m.annotations, oci.DESCRIPTION)))
      + listed("args      ", config.args)
      + listed("env       ", config.env |> list.map((e) => "${e.name}=${e.value}"))
      + listed("asks for  ", wants)
    println(list.join(lines, "\n"))
  }
  0
}

local effect fn cmd_tag(args: List[String]) -> Int = {
  let (source, target) = match args {
    [s, t] => (reference.parse(s)!, reference.parse(t)!),
    _ => err("tag takes two names: nautra tag SOURCE NAME")!,
  }
  guard target.digest == "" else err("a new name cannot carry a digest")!
  let store_dir = store.open()!
  let stored = store.resolve(store_dir, reference.key(source))! |> option.to_result("no image named ${reference.key(source)}")!
  store.set_ref(store_dir, reference.key(target), stored)!
  println("${reference.key(target)}  ${stored.digest}")
  0
}

local effect fn cmd_rmi(args: List[String]) -> Int = {
  guard not list.is_empty(args) else err("rmi needs at least one image")!
  let store_dir = store.open()!
  var missing = 0
  for text in args {
    let key = reference.key(reference.parse(text)!)
    if store.remove_ref(store_dir, key)! then println("removed ${key}") else {
      eprintln("nautra: no image named ${key}")
      missing = missing + 1
    }
  }
  let _ = store.prune(store_dir)!
  if missing == 0 then 0 else 1
}

local effect fn cmd_pull(args: List[String]) -> Int = {
  let r = reference.parse(list.get(args, 0) |> option.to_result("pull needs an image")!)!
  let stored = pull_into(store.open()!, r)!
  println("${reference.key(r)}  ${stored.digest}")
  0
}

local effect fn cmd_push(args: List[String]) -> Int = {
  let r = reference.parse(list.get(args, 0) |> option.to_result("push needs an image")!)!
  let store_dir = store.open()!
  let uploaded = registry.push(store_dir, r)!
  let stored = store.resolve(store_dir, reference.key(r))! |> option.to_result("no image named ${reference.key(r)}")!
  println("${reference.key(r)}  ${stored.digest}  (${uploaded} blob${if uploaded == 1 then "" else "s"} uploaded)")
  0
}

local effect fn dispatch(args: List[String]) -> Int = {
  let rest = list.drop(args, 1)
  match list.get(args, 0) ?? "help" {
    "run" => cmd_run(rest)!,
    "build" => cmd_build(rest)!,
    "images" | "image" | "ls" => cmd_images()!,
    "inspect" => cmd_inspect(rest)!,
    "replay" => cmd_replay(rest)!,
    "tag" => cmd_tag(rest)!,
    "rmi" => cmd_rmi(rest)!,
    "ps" => cmd_ps(rest)!,
    "logs" => cmd_logs(rest)!,
    "stop" => cmd_stop(rest)!,
    "rm" => cmd_rm(rest)!,
    "pull" => cmd_pull(rest)!,
    "push" => cmd_push(rest)!,
    "version" | "--version" | "-V" => {
      println("nautra ${help.VERSION}")
      0
    },
    "help" | "--help" | "-h" => {
      println(help.usage())
      0
    },
    other => err("unknown command '${other}'; see `nautra help`")!,
  }
}

// 125 is a run nautra itself refused or could not start, as in the tools
// this one sits beside; the guest's own exit code is passed through.
effect fn main() -> Unit = {
  match dispatch(env.args()) {
    ok(code) => process.exit(code),
    err(message) => {
      eprintln("nautra: ${message}")
      process.exit(125)
    },
  }
}

test "sizes read in decimal units" {
  assert_eq(human_size(999), "999 B")
  assert_eq(human_size(3651), "3.6 kB")
  assert_eq(human_size(1234567), "1.2 MB")
}

test "a table pads every column but the last" {
  assert_eq(table([["NAME", "KIND"], ["app:v1", "module"]]), "NAME    KIND\napp:v1  module")
}

test "digests are shortened for display" {
  assert_eq(short("sha256:0123456789abcdef"), "0123456789ab")
}
