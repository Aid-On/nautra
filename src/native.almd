// SPDX-License-Identifier: Apache-2.0
// Native commands, handed to Porta.
//
// Nautra confines Wasm. A tool or a check that is a native program — git, a
// compiler, a test runner — is confined by Porta, nautra's sister, with the
// host kernel. An entry's grants are written in nautra's words and turned
// into Porta's options here, keeping nautra's stance: what the entry does
// not name stays closed.
//
// Where Porta cannot hold a native process to what nautra's words would
// promise, the entry is refused rather than run more openly.

import env
import fs
import path
import self.grants

local fn is_address(host: String) -> Bool =
  string.contains(host, ":") or (string.to_list(host) |> list.all((c) => string.is_digit(c) or c == "."))

// A mount for a native command is a host directory seen where it is: Porta
// does not move a directory to another path the way a Wasm guest sees one.
local fn mount(base: String, text: String) -> List[String]! = {
  let (host, readonly) = match string.strip_suffix(text, ":ro") {
    some(h) => (h, true),
    none => (string.strip_suffix(text, ":rw") ?? text, false),
  }
  guard host != "" and not string.contains(host, ":") else err("'${text}': a native command sees host directories where they are; write DIR or DIR:ro, with no guest path")
  let absolute = if path.is_absolute(host) then host else path.join(base, host)
  ["-v", if readonly then "${absolute}:ro" else absolute]
}

// One network grant as Porta can enforce it. Returns a host for Porta's
// proxy (the only way it holds a process to a name), or a port rule.
local fn net_rule(text: String) -> (String, String)! = {
  let rule = grants.parse_net(text)!
  if rule.host == "*" then ("", "*:${rule.port}")
  else {
    guard not is_address(rule.host) else err("'${text}': Porta holds a native command to host names (over HTTPS) or to ports, not to an address; write a name, or *:PORT")
    guard rule.port == 0 or rule.port == 443 else err("'${text}': Porta holds a native command to a host name over HTTPS only; write ${rule.host}, or *:${rule.port} for the port alone")
    (rule.host, "")
  }
}

// The arguments Porta is run with for one entry: `run COMMAND [options] -- ARGS`.
// `timeout` is in the entry's own words (`30s`); `extra` are options passed
// to Porta as they are, for what only Porta has a word for.
fn porta_args(command: List[String], base: String, mounts: List[String], net: List[String], env_grants: List[String], secrets: List[String], timeout: String?, reads: String, extra: List[String]) -> List[String]! = {
  let program = list.first(command) |> option.to_result("command is empty")!
  guard reads == "strict" or reads == "open" else err("reads is 'strict' or 'open', not '${reads}'")
  let mount_options = mounts |> list.map((m) => mount(base, m)!)! |> list.flatten
  let open = list.contains(net, "*")
  let rules = net |> list.filter((n) => n != "*") |> list.map((n) => net_rule(n)!)!
  let bound = secrets |> list.map((s) => grants.parse_secret(s)!)!
  for secret in bound {
    for place in secret.hosts {
      guard place.port == 443 and not is_address(place.host) else err("secret ${secret.name}: for a native command a secret is bound to a host name over HTTPS, not to ${place.host}:${place.port}")
    }
  }
  let credentials = bound |> list.flat_map((s) => ["--credential", "${s.name}=${s.hosts |> list.map((h) => h.host) |> list.join(",")}"])
  // A credential turns Porta's proxy on, and a proxy with no allow list lets
  // every host through: the hosts a secret is bound to are the allow list.
  let hosts = (rules |> list.map(((host, _)) => host) |> list.filter((h) => h != "")) + (bound |> list.flat_map((s) => s.hosts |> list.map((h) => h.host)))
  let ports = rules |> list.map(((_, port)) => port) |> list.filter((p) => p != "") |> list.flat_map((p) => ["--allow-net", p])
  let network = if open then []
    else if list.is_empty(hosts) and list.is_empty(ports) then ["--no-net"]
    else (if list.is_empty(hosts) then [] else ["--proxy-allow", list.join(list.unique(hosts), ",")]) + ports
  let variables = env_grants |> list.flat_map((e) => if string.contains(e, "=") then ["-e", e] else ["--env-pass", e])
  let deadline = match timeout {
    some(text) => ["--timeout", int.to_string((grants.parse_duration(text)! + 999) / 1000)],
    none => [],
  }
  let rest = list.drop(command, 1)
  ["run", program] + mount_options + network + credentials + variables + deadline + ["--read-policy", reads] + extra + (if list.is_empty(rest) then [] else ["--"] + rest)
}

// Where Porta is: NAUTRA_PORTA, or the first `porta` on PATH.
effect fn porta() -> String = {
  let named = env.get("NAUTRA_PORTA") ?? ""
  let found = if named != "" then some(named) else
    string.split(env.get("PATH") ?? "", ":") |> list.map((dir) => path.join(dir, "porta")) |> list.find((candidate) => fs.is_file(candidate))
  found |> option.to_result("this is a native command, which nautra hands to Porta to confine, and porta is not installed (https://github.com/almide/porta); nautra itself confines only Wasm")!
}

test "nothing is open unless the entry says so" {
  assert_eq(porta_args(["git", "status"], "/p", [], [], [], [], none, "strict", []), ok(["run", "git", "--no-net", "--read-policy", "strict", "--", "status"]))
  assert_eq(porta_args(["true"], "/p", [], [], [], [], none, "open", []), ok(["run", "true", "--no-net", "--read-policy", "open"]))
}

test "grants become Porta's options" {
  let args = porta_args(["cargo", "test"], "/p", ["repo", "/abs/cache:ro"], ["crates.io", "*:8080"], ["CI=1", "HOME"], ["TOKEN@api.example.com"], some("90s"), "open", ["--max-procs", "200"])!
  assert_eq(args, [
    "run", "cargo",
    "-v", "/p/repo", "-v", "/abs/cache:ro",
    "--proxy-allow", "crates.io,api.example.com", "--allow-net", "*:8080",
    "--credential", "TOKEN=api.example.com",
    "-e", "CI=1", "--env-pass", "HOME",
    "--timeout", "90",
    "--read-policy", "open",
    "--max-procs", "200",
    "--", "test",
  ])
  assert_eq(list.contains(porta_args(["x"], "/p", [], ["*"], [], [], none, "strict", [])!, "--no-net"), false)
  assert_eq(porta_args(["x"], "/p", [], [], [], [], some("500ms"), "strict", [])!, ["run", "x", "--no-net", "--timeout", "1", "--read-policy", "strict"])
}

test "what Porta cannot hold a native command to is refused" {
  assert(result.is_err(porta_args(["x"], "/p", ["a:/guest"], [], [], [], none, "strict", [])))
  assert(result.is_err(porta_args(["x"], "/p", [], ["10.0.0.1:443"], [], [], none, "strict", [])))
  assert(result.is_err(porta_args(["x"], "/p", [], ["example.com:8080"], [], [], none, "strict", [])))
  assert(result.is_err(porta_args(["x"], "/p", [], [], [], ["K@127.0.0.1:8080"], none, "strict", [])))
  assert(result.is_err(porta_args(["x"], "/p", [], [], [], [], none, "loose", [])))
  assert(result.is_err(porta_args([], "/p", [], [], [], [], none, "strict", [])))
}
