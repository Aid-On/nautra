// SPDX-License-Identifier: Apache-2.0
// The composition file (`nautra.toml`): one workload, and the tools it may
// call. See docs/adr/0002-agents.md.
//
// The file says nothing `run` could not say on its command line. Each entry
// is read into the same options `run` takes, so there is one grammar for
// grants and one parser that judges them.

import fs
import path
import self.engine
import self.grants
import self.native

// A tool: an image started fresh for each call, with its own options. When
// `agent` names another composition file, the tool is that whole
// composition — an agent with tools of its own — given one argument, `task`.
//
// When `native` is not empty the tool is a native command, and these are the
// arguments nautra is started with to run it confined (see native.almd).
type Tool = {
  name: String,
  image: String,
  agent: String,
  native: List[String],
  options: List[String],
  description: String,
  input: Value,
  max_calls: Int,
}

// An image that must agree: before the tools named in `before` are called
// (`*` is every tool), or, with `finish`, before the run is accepted.
type Check = {
  name: String,
  image: String,
  native: List[String],
  options: List[String],
  before: List[String],
  finish: Bool,
}

type Composition = {
  image: String,
  options: List[String],
  args: List[String],
  tools: List[Tool],
  checks: List[Check],
  max_tool_calls: Int,
  // With `[invoke]`: where the workload is published, run once for each
  // request, and the host variable holding the callers' token. "" for none.
  invoke: String,
  invoke_token: String,
}

local let GRANT_KEYS = ["mounts", "net", "env", "secrets", "auth", "timeout", "memory", "fuel"]

local fn only_keys(table: Value, allowed: List[String], where: String) -> Unit! = {
  let keys = (value.as_object(table) |> result.map_err((_) => "${where} must be a table")!) |> list.map(((k, _)) => k)
  match keys |> list.find((k) => not list.contains(allowed, k)) {
    some(k) => err("unknown key '${k}' in ${where}; expected one of: ${list.join(allowed, ", ")}"),
    none => (),
  }
}

local fn strings(table: Value, key: String, where: String) -> List[String]! = match value.get(table, key) {
  none => [],
  some(v) => {
    let items = value.as_array(v) |> result.map_err((_) => "${where} ${key} must be a list of strings")!
    items |> list.map((item) => value.as_string(item) |> result.map_err((_) => "${where} ${key} must be a list of strings")!)!
  },
}

local fn text(table: Value, key: String, where: String) -> String?! = match value.get(table, key) {
  none => none,
  some(v) => some(value.as_string(v) |> result.map_err((_) => "${where} ${key} must be a string")!),
}

local fn count(table: Value, key: String, where: String) -> Int! = match value.get(table, key) {
  none => 0,
  some(v) => {
    let n = value.as_int(v) |> result.map_err((_) => "${where} ${key} must be a whole number")!
    guard n > 0 else err("${where} ${key} must be greater than zero")
    n
  },
}

// A path in the file is relative to the file, not to where nautra was run.
local fn beside(base: String, p: String) -> String = if path.is_absolute(p) then p else path.join(base, p)

// An image that is written as a path is a .wasm file beside the file.
local fn image_at(base: String, image: String) -> String =
  if string.ends_with(image, ".wasm") or string.starts_with(image, "./") or string.starts_with(image, "../") or string.starts_with(image, "/") then beside(base, image)
  else image

local fn mount_at(base: String, mount: String) -> String = match string.split_once(mount, ":") {
  some((host, rest)) => "${beside(base, host)}:${rest}",
  none => mount,
}

// The grants of one entry, as the options `run` would be given.
local fn grant_options(table: Value, base: String, where: String) -> List[String]! = {
  let mounts = strings(table, "mounts", where)! |> list.flat_map((m) => ["-v", mount_at(base, m)])
  let net = strings(table, "net", where)! |> list.flat_map((n) => ["--allow-net", n])
  let env = strings(table, "env", where)! |> list.flat_map((e) => ["-e", e])
  let secrets = strings(table, "secrets", where)! |> list.flat_map((s) => ["--secret", s])
  let timeout = option.to_list(text(table, "timeout", where)!) |> list.flat_map((t) => ["--timeout", t])
  let memory = option.to_list(text(table, "memory", where)!) |> list.flat_map((m) => ["-m", m])
  let fuel = count(table, "fuel", where)!
  let auths = strings(table, "auth", where)! |> list.flat_map((a) => ["--auth", a])
  mounts + net + env + secrets + auths + timeout + memory + (if fuel > 0 then ["--fuel", int.to_string(fuel)] else [])
}

local fn is_tool_name(name: String) -> Bool =
  name != "" and string.len(name) <= 64 and string.to_list(name) |> list.all((c) => (string.is_alphanumeric(c) and string.byte_len(c) == 1) or c == "_" or c == "-")

local let NATIVE_KEYS = ["command", "mounts", "net", "env", "secrets", "timeout", "reads", "porta"]

// What nautra is started with to run an entry that names a native command.
local fn native_args(table: Value, base: String, where: String) -> List[String]! =
  native.arguments(native.Entry {
    command: strings(table, "command", where)!,
    base: base,
    mounts: strings(table, "mounts", where)!,
    net: strings(table, "net", where)!,
    env: strings(table, "env", where)!,
    secrets: strings(table, "secrets", where)!,
    timeout: text(table, "timeout", where)! ?? "",
    reads: text(table, "reads", where)! ?? "strict",
    extra: strings(table, "porta", where)!,
  }) |> result.map_err((e) => "${where} ${e}")

local let TASK_INPUT = value.object([
  ("type", value.string("object")),
  ("properties", value.object([("task", value.object([("type", value.string("string")), ("description", value.string("What to do, in full: the agent is told nothing else."))]))])),
  ("required", value.array([value.string("task")])),
  ("additionalProperties", value.bool(false)),
])

local fn tool(name: String, table: Value, base: String) -> Tool! = {
  let where = "[tools.${name}]"
  guard is_tool_name(name) else err("'${name}' is not a tool name: use letters, digits, '_' and '-'")
  only_keys(table, ["image", "agent", "command", "description", "input", "max_calls", "reads", "porta"] + GRANT_KEYS, where)!
  let image = text(table, "image", where)!
  let agent = text(table, "agent", where)!
  let command = option.is_some(value.get(table, "command"))
  let description = text(table, "description", where)! ?? ""
  let max_calls = count(table, "max_calls", where)!
  let input = value.get(table, "input") ?? value.object([("type", value.string("object"))])
  guard result.is_ok(value.as_object(input)) else err("${where} input must be a JSON Schema object")
  match (image, agent, command) {
    (some(i), none, false) => {
      only_keys(table, ["image", "description", "input", "max_calls"] + GRANT_KEYS, "${where}, which names an image,")!
      Tool { name: name, image: image_at(base, i), agent: "", native: [], options: grant_options(table, base, where)!, description: description, input: input, max_calls: max_calls }
    },
    (none, some(file), false) => {
      // An agent's grants and input are its own file's business.
      only_keys(table, ["agent", "description", "max_calls"], "${where}, which names an agent,")!
      Tool { name: name, image: "", agent: beside(base, file), native: [], options: [], description: description, input: TASK_INPUT, max_calls: max_calls }
    },
    (none, none, true) => {
      only_keys(table, ["description", "input", "max_calls"] + NATIVE_KEYS, "${where}, which names a native command,")!
      Tool { name: name, image: "", agent: "", native: native_args(table, base, where)!, options: [], description: description, input: input, max_calls: max_calls }
    },
    _ => err("${where} needs exactly one of: image, agent, command"),
  }
}

local fn check(name: String, table: Value, base: String) -> Check! = {
  let where = "[checks.${name}]"
  only_keys(table, ["image", "command", "before", "finish", "reads", "porta"] + GRANT_KEYS, where)!
  let image = text(table, "image", where)!
  let command = option.is_some(value.get(table, "command"))
  guard option.is_some(image) != command else err("${where} needs exactly one of: image, command")
  let before = strings(table, "before", where)!
  let finish = match value.get(table, "finish") {
    some(v) => value.as_bool(v) |> result.map_err((_) => "${where} finish must be true or false")!,
    none => false,
  }
  guard finish or not list.is_empty(before) else err("${where} says neither `before = [tools]` nor `finish = true`, so it would never run")
  match image {
    some(i) => {
      only_keys(table, ["image", "before", "finish"] + GRANT_KEYS, "${where}, which names an image,")!
      Check { name: name, image: image_at(base, i), native: [], options: grant_options(table, base, where)!, before: before, finish: finish }
    },
    none => {
      only_keys(table, ["before", "finish"] + NATIVE_KEYS, "${where}, which names a native command,")!
      Check { name: name, image: "", native: native_args(table, base, where)!, options: [], before: before, finish: finish }
    },
  }
}

local fn entries(doc: Value, key: String) -> List[(String, Value)]! = match value.get(doc, key) {
  some(table) => value.as_object(table) |> result.map_err((_) => "[${key}] must be a table")!,
  none => [],
}

// A composition with `[mcp]` in place of `[agent]`: it runs no workload and
// publishes its tools as an MCP server, for an agent that lives elsewhere.
// `token` names the host variable holding the bearer token a caller must
// present; it is "" when the file says `open = true` or listens on this
// machine only.
type Published = {
  listen: String,
  token: String,
  audit: String,
  tools: List[Tool],
  checks: List[Check],
}

fn publishes(doc: Value) -> Bool = option.is_some(value.get(doc, "mcp"))

local fn is_loopback(address: String) -> Bool =
  string.starts_with(address, "127.") or string.starts_with(address, "[::1]:") or string.starts_with(address, "localhost:")

// Where a table listens and who may call: its address, and the name of the
// host variable holding the callers' bearer token ("" for none). Whoever
// reaches the address can call, so beyond this machine that is never left
// unsaid.
local fn door(table: Value, where: String) -> (String, String)! = {
  let listen = grants.parse_publish(text(table, "listen", where)! |> option.to_result("${where} needs listen = \"PORT\" or \"ADDRESS:PORT\"")!) |> result.map_err((e) => "${where} listen: ${e}")!
  let token = text(table, "token", where)! ?? ""
  let open = match value.get(table, "open") {
    some(v) => value.as_bool(v) |> result.map_err((_) => "${where} open must be true or false")!,
    none => false,
  }
  guard not (open and token != "") else err("${where} says both `open = true` and a token; it is one or the other")
  guard token != "" or open or is_loopback(listen) else err("${where} listens on ${listen}, beyond this machine, and does not say who may call: name a host variable holding a bearer token (`token = \"NAME\"`), or write `open = true` where something in front of nautra decides that")
  (listen, token)
}

fn parse_published(doc: Value, base: String) -> Published! = {
  guard option.is_none(value.get(doc, "agent")) else err("nautra.toml has both [agent] and [mcp]: a file runs an agent with its tools, or publishes the tools, not both")
  only_keys(doc, ["mcp", "tools", "checks"], "nautra.toml")!
  let table = value.get(doc, "mcp") |> option.to_result("nautra.toml needs an [mcp] table")!
  only_keys(table, ["listen", "token", "open", "audit"], "[mcp]")!
  let (listen, token) = door(table, "[mcp]")!
  let tools = entries(doc, "tools")! |> list.map(((name, table)) => tool(name, table, base)!)!
  guard not list.is_empty(tools) else err("[mcp] publishes the file's tools, and it has none")
  let checks = entries(doc, "checks")! |> list.map(((name, table)) => check(name, table, base)!)!
  for c in checks {
    guard not c.finish else err("[checks.${c.name}] is a finish check, and published tools have no run that finishes; set it `before` a tool")
    for named in c.before {
      guard named == "*" or list.any(tools, (t) => t.name == named) else err("[checks.${c.name}] is set before '${named}', which is not one of the tools")
    }
  }
  Published {
    listen: listen,
    token: token,
    audit: match text(table, "audit", "[mcp]")! { some(a) => beside(base, a), none => "" },
    tools: tools,
    checks: checks,
  }
}

// Reads a parsed composition file. `base` is the directory the file is in.
fn parse(doc: Value, base: String) -> Composition! = {
  guard not publishes(doc) else err("this file publishes its tools ([mcp]) and has no agent to run; give it to `nautra run -f` on its own")
  only_keys(doc, ["agent", "tools", "checks", "invoke"], "nautra.toml")!
  let agent = value.get(doc, "agent") |> option.to_result("nautra.toml needs an [agent] table")!
  only_keys(agent, ["image", "args", "publish", "audit", "max_tool_calls"] + GRANT_KEYS, "[agent]")!
  let image = text(agent, "image", "[agent]")! |> option.to_result("[agent] needs an image")!
  let publish = option.to_list(text(agent, "publish", "[agent]")!) |> list.flat_map((p) => ["-p", p])
  let audit = option.to_list(text(agent, "audit", "[agent]")!) |> list.flat_map((a) => ["--audit", beside(base, a)])
  let tools = entries(doc, "tools")! |> list.map(((name, table)) => tool(name, table, base)!)!
  let checks = entries(doc, "checks")! |> list.map(((name, table)) => check(name, table, base)!)!
  for c in checks {
    for named in c.before {
      guard named == "*" or list.any(tools, (t) => t.name == named) else err("[checks.${c.name}] is set before '${named}', which is not one of the tools")
    }
  }
  // [invoke] publishes a workload that ends: each request is one run of it.
  let (invoke, invoke_token) = match value.get(doc, "invoke") {
    some(table) => {
      only_keys(table, ["listen", "token", "open"], "[invoke]")!
      guard list.is_empty(publish) else err("[agent] publish is for an HTTP service, which answers requests itself; [invoke] runs a workload that ends once for each request. A file has one or the other")
      door(table, "[invoke]")!
    },
    none => ("", ""),
  }
  Composition {
    image: image_at(base, image),
    options: grant_options(agent, base, "[agent]")! + publish + audit,
    args: strings(agent, "args", "[agent]")!,
    tools: tools,
    checks: checks,
    max_tool_calls: count(agent, "max_tool_calls", "[agent]")!,
    invoke: invoke,
    invoke_token: invoke_token,
  }
}

// A `run` line with `-f FILE` taken out: the file, the other options, and
// the workload's own arguments. The file is "" when there was no `-f`.
fn split_file(args: List[String]) -> (String, List[String], List[String]) = {
  let n = grants.option_count(args)
  var file = ""
  var options: List[String] = []
  var take_file = false
  for arg in list.take(args, n) {
    if take_file then {
      file = arg
      take_file = false
    } else if arg == "-f" or arg == "--file" then {
      take_file = true
    } else if string.starts_with(arg, "--file=") then {
      file = string.drop(arg, 7)
    } else {
      options = options + [arg]
    }
  }
  (file, options, list.drop(args, n))
}

// Turns a `run` line that names a composition file into the line it stands
// for, and returns the composition beside it. Options on the command line
// come after the file's, so they add to it.
// The composition a `run` line names, when it is one that publishes tools.
// Such a file is the whole line: there is no workload for an option or an
// argument to belong to.
effect fn published(args: List[String]) -> Published? = {
  let (file, options, rest) = split_file(args)
  if file == "" then none else {
    let source = fs.read_text(file) |> result.map_err((e) => "cannot read ${file}: ${e}")!
    let doc = engine.toml(source) |> result.map_err((e) => "${file}: ${e}")!
    if not publishes(doc) then none else {
      guard list.is_empty(options) and list.is_empty(rest) else err("${file} publishes tools and runs no workload, so it takes no other option or argument; say it in the file")!
      some(parse_published(doc, path.dirname(file)) |> result.map_err((e) => "${file}: ${e}")!)
    }
  }
}

effect fn expand(args: List[String]) -> (List[String], Composition?) = {
  let (file, options, rest) = split_file(args)
  if file == "" then (args, none) else {
    let source = fs.read_text(file) |> result.map_err((e) => "cannot read ${file}: ${e}")!
    let doc = engine.toml(source) |> result.map_err((e) => "${file}: ${e}")!
    let c = parse(doc, path.dirname(file)) |> result.map_err((e) => "${file}: ${e}")!
    (c.options + options + [c.image] + (if list.is_empty(rest) then c.args else rest), some(c))
  }
}

local fn sample() -> Value = value.object([
  ("agent", value.object([
    ("image", value.string("agent.wasm")),
    ("secrets", value.array([value.string("MODEL_KEY@api.example.com")])),
    ("mounts", value.array([value.string("ws:/work:ro")])),
    ("timeout", value.string("2m")),
    ("max_tool_calls", value.int(8)),
  ])),
  ("tools", value.object([
    ("calc", value.object([("image", value.string("ghcr.io/you/calc:v1")), ("max_calls", value.int(3))])),
    ("read_file", value.object([
      ("image", value.string("./tools/read.wasm")),
      ("description", value.string("Read a file.")),
      ("mounts", value.array([value.string("./ws:/work:ro")])),
    ])),
  ])),
])

test "an entry becomes run options, with paths beside the file" {
  let c = parse(sample(), "/proj")!
  assert_eq(c.image, "/proj/agent.wasm")
  assert_eq(c.options, ["-v", "/proj/ws:/work:ro", "--secret", "MODEL_KEY@api.example.com", "--timeout", "2m"])
  assert_eq(c.max_tool_calls, 8)
  let calc = list.find(c.tools, (t) => t.name == "calc") ?? panic("no calc")
  assert_eq(calc.image, "ghcr.io/you/calc:v1")
  assert_eq(calc.options, [])
  assert_eq(calc.max_calls, 3)
  let read = list.find(c.tools, (t) => t.name == "read_file") ?? panic("no read_file")
  assert_eq(read.image, "/proj/./tools/read.wasm")
  assert_eq(read.options, ["-v", "/proj/./ws:/work:ro"])
  assert_eq(read.description, "Read a file.")
}

test "the options an entry becomes are ones run accepts" {
  let c = parse(sample(), "/proj")!
  let line = grants.parse_run(c.options + [c.image])!
  assert_eq(list.len(line.grants.secrets), 1)
  assert_eq(line.grants.timeout_ms, 120000)
}

test "mistakes in the file are refused" {
  assert(result.is_err(parse(value.object([]), ".")))
  assert(result.is_err(parse(value.object([("agent", value.object([("image", value.string("a")), ("mount", value.array([]))]))]), ".")))
  assert(result.is_err(parse(value.object([("agent", value.object([("image", value.string("a"))])), ("tool", value.object([]))]), ".")))
  let bad_name = value.object([("agent", value.object([("image", value.string("a"))])), ("tools", value.object([("a b", value.object([("image", value.string("t"))]))]))])
  assert(result.is_err(parse(bad_name, ".")))
  let no_image = value.object([("agent", value.object([("image", value.string("a"))])), ("tools", value.object([("t", value.object([]))]))])
  assert(result.is_err(parse(no_image, ".")))
}

test "-f is taken out of a run line" {
  assert_eq(split_file(["-f", "nautra.toml", "-d", "--name", "a", "hello", "-f"]), ("nautra.toml", ["-d", "--name", "a"], ["hello", "-f"]))
  assert_eq(split_file(["--file=x.toml"]), ("x.toml", [], []))
  assert_eq(split_file(["-v", "a:/a", "app", "x"]), ("", ["-v", "a:/a"], ["app", "x"]))
}

test "a tool may be another agent, and a check says when it runs" {
  let doc = value.object([
    ("agent", value.object([("image", value.string("a.wasm"))])),
    ("tools", value.object([
      ("reviewer", value.object([("agent", value.string("reviewer.toml")), ("description", value.string("Reviews."))])),
      ("write", value.object([("image", value.string("w.wasm"))])),
    ])),
    ("checks", value.object([
      ("guard", value.object([("image", value.string("g.wasm")), ("before", value.array([value.string("write")]))])),
      ("tests", value.object([("image", value.string("t.wasm")), ("finish", value.bool(true)), ("mounts", value.array([value.string("ws:/work:ro")]))])),
    ])),
  ])
  let c = parse(doc, "/p")!
  let reviewer = list.find(c.tools, (t) => t.name == "reviewer") ?? panic("no reviewer")
  assert_eq(reviewer.agent, "/p/reviewer.toml")
  assert_eq(reviewer.image, "")
  assert_eq(value.get_array(reviewer.input, "required"), some([value.string("task")]))
  let tests = list.find(c.checks, (k) => k.name == "tests") ?? panic("no tests")
  assert(tests.finish)
  assert_eq(tests.options, ["-v", "/p/ws:/work:ro"])
  assert_eq((list.find(c.checks, (k) => k.name == "guard") ?? panic("no guard")).before, ["write"])
}

test "a tool is an image or an agent, and a check has an occasion" {
  let with = (tools: Value, checks: Value) => parse(value.object([("agent", value.object([("image", value.string("a.wasm"))])), ("tools", tools), ("checks", checks)]), ".")
  let none_yet = value.object([])
  assert(result.is_err(with(value.object([("t", value.object([("image", value.string("i")), ("agent", value.string("f"))]))]), none_yet)))
  assert(result.is_err(with(value.object([("t", value.object([("agent", value.string("f")), ("mounts", value.array([]))]))]), none_yet)))
  assert(result.is_err(with(none_yet, value.object([("c", value.object([("image", value.string("i"))]))]))))
  assert(result.is_err(with(none_yet, value.object([("c", value.object([("image", value.string("i")), ("before", value.array([value.string("absent")]))]))]))))
}

test "a tool or a check may be a native command" {
  let doc = value.object([
    ("agent", value.object([("image", value.string("a.wasm"))])),
    ("tools", value.object([
      ("log", value.object([("command", value.array([value.string("git"), value.string("log")])), ("mounts", value.array([value.string("repo:ro")]))])),
    ])),
    ("checks", value.object([
      ("tests", value.object([("command", value.array([value.string("make"), value.string("test")])), ("finish", value.bool(true)), ("reads", value.string("open"))])),
    ])),
  ])
  let c = parse(doc, "/p")!
  let log = native.decode(list.get((list.first(c.tools) ?? panic("no tool")).native, 1) ?? "")!
  assert_eq(log.command, ["git", "log"])
  assert_eq(log.mounts, ["repo:ro"])
  assert_eq(log.base, "/p")
  assert_eq(log.reads, "strict")
  let tests = native.decode(list.get((list.first(c.checks) ?? panic("no check")).native, 1) ?? "")!
  assert_eq(tests.command, ["make", "test"])
  assert_eq(tests.reads, "open")
  let both = value.object([("agent", value.object([("image", value.string("a.wasm"))])), ("tools", value.object([("t", value.object([("image", value.string("i")), ("command", value.array([value.string("x")]))]))]))])
  assert(result.is_err(parse(both, ".")))
  let fuel = value.object([("agent", value.object([("image", value.string("a.wasm"))])), ("tools", value.object([("t", value.object([("command", value.array([value.string("x")])), ("fuel", value.int(5))]))]))])
  assert(result.is_err(parse(fuel, ".")))
}

local fn published_doc(mcp: List[(String, Value)], extra: List[(String, Value)]) -> Value = value.object([
  ("mcp", value.object(mcp)),
  ("tools", value.object([("upper", value.object([("image", value.string("upper.wasm"))]))])),
] + extra)

test "a file with [mcp] publishes its tools" {
  let p = parse_published(published_doc([("listen", value.string("8000")), ("audit", value.string("calls.jsonl"))], []), "/p")!
  assert_eq(p.listen, "127.0.0.1:8000")
  assert_eq(p.token, "")
  assert_eq(p.audit, "/p/calls.jsonl")
  assert_eq(list.map(p.tools, (t) => t.name), ["upper"])
  let named = parse_published(published_doc([("listen", value.string("0.0.0.0:8000")), ("token", value.string("MCP_TOKEN"))], []), "/p")!
  assert_eq(named.token, "MCP_TOKEN")
  assert(result.is_ok(parse_published(published_doc([("listen", value.string("0.0.0.0:8000")), ("open", value.bool(true))], []), "/p")))
}

test "tools are not published beyond this machine without a word on who may call" {
  assert(result.is_err(parse_published(published_doc([("listen", value.string("0.0.0.0:8000"))], []), "/p")))
  assert(result.is_err(parse_published(published_doc([("listen", value.string("0.0.0.0:8000")), ("open", value.bool(true)), ("token", value.string("T"))], []), "/p")))
  assert(result.is_err(parse_published(published_doc([], []), "/p")))
  assert(result.is_err(parse_published(published_doc([("listen", value.string("8000"))], [("agent", value.object([("image", value.string("a.wasm"))]))]), "/p")))
  assert(result.is_err(parse_published(value.object([("mcp", value.object([("listen", value.string("8000"))]))]), "/p")))
  let finish = [("checks", value.object([("c", value.object([("image", value.string("c.wasm")), ("finish", value.bool(true))]))]))]
  assert(result.is_err(parse_published(published_doc([("listen", value.string("8000"))], finish), "/p")))
  assert(result.is_err(parse(published_doc([("listen", value.string("8000"))], []), "/p")))
}

test "[invoke] publishes a workload that ends, with the same word on who may call" {
  let with = (invoke: List[(String, Value)], agent: List[(String, Value)]) => parse(value.object([
    ("agent", value.object([("image", value.string("a.wasm"))] + agent)),
    ("invoke", value.object(invoke)),
  ]), "/p")
  let c = with([("listen", value.string("8080"))], [])!
  assert_eq(c.invoke, "127.0.0.1:8080")
  assert_eq(c.invoke_token, "")
  assert_eq(with([("listen", value.string("0.0.0.0:8080")), ("token", value.string("T"))], [])!.invoke_token, "T")
  assert(result.is_ok(with([("listen", value.string("0.0.0.0:8080")), ("open", value.bool(true))], [])))
  assert(result.is_err(with([("listen", value.string("0.0.0.0:8080"))], [])))
  assert(result.is_err(with([], [])))
  assert(result.is_err(with([("listen", value.string("8080"))], [("publish", value.string("9090"))])))
  assert_eq(parse(sample(), "/p")!.invoke, "")
}
